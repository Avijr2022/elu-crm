# E-LinkUp local development defaults (India / SME)
# Copy to .env if you want overrides: copy .env.example .env

POSTGRES_USER=elinkup
POSTGRES_PASSWORD=elinkup_local
POSTGRES_DB=elinkup
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# Used by FastAPI inside Docker network
DATABASE_URL=postgresql+psycopg://elinkup:elinkup_local@postgres:5432/elinkup
# Used by FastAPI when running on host (outside Docker). Host port 55432 → container 5432.
DATABASE_URL_HOST=postgresql+psycopg://elinkup:elinkup_local@localhost:55432/elinkup

JWT_SECRET_KEY=change-me-elinkup-dev-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=E-LinkUp
APP_ENV=local
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# Tenant seed defaults (Euphoria / India SME)
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_FY_START_MONTH=4
DEFAULT_FY_START_DAY=1
DEFAULT_LOCALE=en_IN
DEFAULT_LANGUAGE=en
DEFAULT_DATE_FORMAT=dd/MM/yyyy

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=elinkup
MINIO_SECRET_KEY=elinkup_minio
MINIO_BUCKET=elinkup-docs

SEED_ADMIN_EMAIL=admin@euphoriainfotech.com
SEED_ADMIN_PASSWORD=Admin@12345
